{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 8 * * *" },
    { "path": "/api/cron/renewal-reminders", "schedule": "0 15 1 * *" },
    { "path": "/api/cron/renewal-reminders?mode=upcoming", "schedule": "0 15 * * *" },
    { "path": "/api/cron/license-lifecycle", "schedule": "0 9 * * *" },
    { "path": "/api/cron/usage-reminders", "schedule": "30 8 * * *" }
  ]
}
