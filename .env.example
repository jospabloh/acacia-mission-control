# ─── Client (exposed to the browser via Vite) ──────────────────────────────
# Supabase project that hosts the Mission Control "bodega" + Auth + members.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Server only (Vercel serverless functions in api/) ─────────────────────
# NEVER prefix these with VITE_ — they must not reach the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared HMAC secret for /api/ingest/* signed payloads from apps.
INGEST_HMAC_SECRET=

# Real-time support-ticket push (api/ingest/ticket.js). Public URL of this
# Mission Control deployment, used to build the "Abrir en Mission Control" link
# in the new-ticket alert email (e.g. https://control.acaciaco.com.mx).
MC_PUBLIC_URL=
# Who receives the internal new-ticket alert (comma-separated). Defaults to
# soporte@acaciaco.com.mx + h.josepablo@gmail.com when unset.
SUPPORT_ALERT_EMAILS=soporte@acaciaco.com.mx,h.josepablo@gmail.com

# Mercado Pago (revenue webhooks). Stripe is NOT used.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Per-app Base44 service tokens, consumed by api/_lib/adapters/base44.js.
# One token per app id; the adapter looks up BASE44_TOKEN_<APP_ID_UPPERCASE>.
# Example (Puntos+): BASE44_TOKEN_696E7FDD7889892FE40868B7=...
# Or a single fallback token used for every app:
BASE44_SERVICE_TOKEN=

# PostHog (Fase 2 — analytics). Optional until then.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.posthog.com

# Machine gate for api/cron/* — REQUIRED. Without it every cron answers 503
# (see api/_lib/requireCron.js for why it fails closed rather than open).
# Set it in Vercel too: with the variable present, Vercel attaches
# `Authorization: Bearer <CRON_SECRET>` to scheduled invocations by itself.
CRON_SECRET=
